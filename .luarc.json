{
  "runtime.version": "Lua 5.1",
  "workspace.checkThirdParty": false,
  "diagnostics.globals": [
    "ForeverFlip",
    "ForeverFlipData",
    "LibStub",
    "ERR_AUCTION_WON_S",
    "ERR_AUCTION_SOLD_S",
    "SOUNDKIT",
    "UIErrorsFrame",
    "AuxForeverAPI",
    "ForeverFlipAPI",
    "ForeverFlipRaw",
    "ForeverFlipShared",
    "FCF_OpenNewWindow",
    "FCF_SelectDockFrame"
  ],
  "workspace.ignoreDir": [
    ".git",
    ".github",
    "tests",
    "tools",
    "dist"
  ],
  "diagnostics.disable": [
    "need-check-nil",
    "inject-field",
    "undefined-field",
    "cast-local-type",
    "duplicate-set-field"
  ]
}
